---
import DottedCard from "./DottedCard.astro";
import LetsTalkButton from "./LetsTalkButton.astro";
---

<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-2 sm:py-2 lg:px-8">
    <DottedCard class="p-6 sm:p-8 lg:flex lg:items-center lg:justify-between">
      <span class="max-w-2xl text-2xl font-semibold tracking-tight font-mono">
        Build your AI first product.<br />Curious about what's possible?<span
          class="animate-pulse bg-black">_</span
        >
      </span>
      <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0">
        <LetsTalkButton />
      </div>
    </DottedCard>
  </div>
</div>
