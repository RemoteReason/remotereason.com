---
import BrandBanner from "./BrandBanner.astro";
import LetsTalkCta from "./LetsTalkCta.astro";
import BentoBox from "./layout/BentoBox.astro";
import BentoBoxLarge from "./layout/BentoBoxLarge.astro";
import BentoBoxSmall from "./layout/BentoBoxSmall.astro";
import PageCentered from "./layout/PageCentered.astro";
import ContentCardImageWithText from "./page/ContentCardImageWithText.astro";
import FeaturedCard from "./page/FeaturedCard.astro";
import { pages } from "../data/pages";
import {
  serviceAiEngineering,
  serviceAiGoToMarket,
  serviceAiProductStrategy,
  serviceMobileApps,
  serviceWebApps,
} from "../data/site";
import { imagePath } from "../lib/links";

const largeCards = [
  { page: pages.aiProductStrategy, service: serviceAiProductStrategy },
  { page: pages.aiGoToMarket, service: serviceAiGoToMarket },
];
const smallCards = [
  { page: pages.aiEngineering, service: serviceAiEngineering },
  { page: pages.mobileApps, service: serviceMobileApps },
  { page: pages.webApps, service: { ...serviceWebApps, name: "Web apps" } },
];
---

<PageCentered>
  <BrandBanner />
  <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
    <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16">
      <FeaturedCard
        title="AI native"
        description="We advise & build AI native platforms for startups. We add AI sparkles to existing products."
        icon="hero-face-smile"
      />
      <FeaturedCard
        title="US & EU"
        description="We work with clients both in Europe & United States."
        icon="hero-globe-alt"
      />
      <FeaturedCard
        title="Fly together"
        description="We build your software product from idea to MVP and beyond. We handle design, AI magic, web / mobile & cloud deployments."
        icon="hero-arrow-trending-up"
      />
      <FeaturedCard
        title="Fast time to market"
        description="We have experience with fast moving product roadmaps. We start fast. We ship often."
        icon="hero-forward"
      />
    </dl>
  </div>
</PageCentered>

<PageCentered>
  <h2 class="text-base/7 font-semibold text-indigo-600">humans & bots working together</h2>
  <p class="mt-2 max-w-lg text-pretty text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl">
    strategy, product & engineering
  </p>
  <BentoBox>
    {
      largeCards.map(({ page, service }) => (
        <BentoBoxLarge>
          <a href={page.url}>
            <ContentCardImageWithText
              title={service.name}
              subtitle={service.subtitle}
              description={service.description}
              image={imagePath(service.image)}
            />
          </a>
        </BentoBoxLarge>
      ))
    }
    {
      smallCards.map(({ page, service }) => (
        <BentoBoxSmall>
          <a href={page.url}>
            <ContentCardImageWithText
              title={service.name}
              subtitle={service.subtitle}
              description={service.description}
              image={imagePath(service.image)}
            />
          </a>
        </BentoBoxSmall>
      ))
    }
  </BentoBox>
</PageCentered>
<LetsTalkCta />
