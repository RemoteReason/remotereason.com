---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="bg-white">
  <div class="mx-auto">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2 class="text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl">{title}</h2>
      <p class="mt-8 text-pretty text-lg font-medium text-gray-500 sm:text-xl/8">{description}</p>
    </div>
  </div>
</div>
