---
import Icon from "../Icon.astro";

interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items } = Astro.props;
---

<div
  class="-m-2 grid grid-cols-1 rounded-[2rem] ring-1 ring-black/5 max-lg:mx-auto max-lg:w-full max-lg:max-w-md"
>
  <div class="grid grid-cols-1 rounded-[2rem] p-2">
    <div class="rounded-3xl bg-white p-10 pb-9">
      <h2 class="text-lg font-bold text-indigo-600">{title}</h2>
      <p class="mt-2 text-lg/8 text-gray-600">{description}</p>
      <div class="mt-8">
        <ul class="mt-3 space-y-3">
          {
            items.map((item) => (
              <li class="group flex items-start gap-4 text-gray-600">
                <span class="inline-flex h-6 items-center">
                  <Icon name="hero-check-circle" class="h-5 w-5" />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>
