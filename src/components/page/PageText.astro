---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="container mx-auto px-6 md:pt-2">
  <h1 class="text-3xl font-semibold leading-normal md:leading-10 py-4 text-left md:text-4xl">{title}</h1>
  <div class="text-base/7 text-gray-700">
    <slot />
  </div>
</div>
