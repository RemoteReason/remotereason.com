---
import DottedCard from "../DottedCard.astro";
import BoxSmall from "./BoxSmall.astro";

interface Props {
  stats: { title: string; subtitle: string }[];
}

const { stats } = Astro.props;
---

<DottedCard
  class="relative flex flex-col justify-between space-y-6 px-6 py-2 md:px-6 md:py-3 md:space-y-0 md:flex-row md:[&>*+*]:ml-7 my-10"
>
  {stats.map((stat) => <BoxSmall title={stat.title} subtitle={stat.subtitle} />)}
</DottedCard>
