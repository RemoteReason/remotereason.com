---
import ClutchTestimonialsWidget from "../../components/ClutchTestimonialsWidget.astro";
import CountryFlag from "../../components/CountryFlag.astro";
import LetsTalkCta from "../../components/LetsTalkCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pages } from "../../data/pages";
import { clients } from "../../data/site";
import { imagePath } from "../../lib/links";

const page = pages.clients;
---

<BaseLayout title={page.title} description={page.description} openGraph={page.openGraph}>
  <div class="bg-white py-14 sm:py-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h2 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Our clients</h2>
        <p class="mt-6 text-lg/8 text-gray-600">We are here to deliver value to our clients every day.</p>
      </div>
      <ul
        role="list"
        class="mx-auto mt-10 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3"
      >
        {
          clients.map((client) => (
            <li>
              <a href={`https://${client.website}`}>
                <img class="aspect-[3/2] w-full rounded-2xl object-cover" src={imagePath(client.image)} alt="" />
                <h3 class="mt-6 text-lg/8 font-semibold tracking-tight text-gray-900">
                  {client.name}
                  <CountryFlag countryCode={client.countryCode} label={`${client.location}, ${client.countryCode}`} />
                </h3>
                <span class="text-gray-600 hover:text-gray-900 underline">&gt; {client.website}</span>
                <p class="text-base/7 text-gray-600">{client.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-7xl lg:mx-0 mt-12 mb-12">
        <h2 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl text-center">
          People like working with us
        </h2>
      </div>
      <ClutchTestimonialsWidget />
    </div>
  </div>
  <LetsTalkCta />
</BaseLayout>
