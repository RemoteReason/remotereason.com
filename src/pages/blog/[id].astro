---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import LetsTalkCta from "../../components/LetsTalkCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPostPageData } from "../../data/pages";
import { blogPostPath, blogPostThumbnailPath, formatDate } from "../../lib/links";
import { getPosts } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const page = blogPostPageData(post);
---

<BaseLayout title={page.title} description={page.description} openGraph={page.openGraph} variant="blog">
  <div class="bg-white px-6 py-12 lg:px-8">
    <div class="lg:flex lg:items-center lg:justify-between">
      <div class="min-w-0 flex-1">
        <h2 class="text-2xl/7 font-bold text-gray-900 sm:text-3xl sm:tracking-tight">{post.data.title}</h2>
        <div class="mt-1 flex flex-col sm:mt-0 sm:flex-row sm:flex-wrap sm:space-x-6">
          <div class="mt-2 flex items-center text-sm text-gray-500 py-2">
            <Icon name="hero-user" class="h-5 w-5 px-2" />
            <span class="px-2">{post.data.author}</span>
          </div>

          <div class="mt-2 flex items-center text-sm text-gray-500 py-2">
            <Icon name="hero-calendar" class="h-5 w-5 px-2" />
            <time class="px-2" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
          </div>

          <div class="mt-2 flex items-center text-sm text-gray-500 py-2">
            <Icon name="hero-tag" class="h-5 w-5" />
            <span class="px-2">
              {
                post.data.tags.map((tag) => (
                  <Fragment>
                    <a
                      href={blogPostPath(post)}
                      class="inline-flex items-center rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10"
                    >
                      {tag}
                    </a>{" "}
                  </Fragment>
                ))
              }
            </span>
          </div>
        </div>
      </div>
    </div>

    <img src={blogPostThumbnailPath(post)} alt={post.data.title} class="w-full h-auto py-4" />
    <div class="mx-auto max-w-[96rem] py-8 text-base/7 text-gray-700 [&_.prose]:max-w-none">
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
  <LetsTalkCta />
</BaseLayout>
