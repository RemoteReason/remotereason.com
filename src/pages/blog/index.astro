---
import BrandBanner from "../../components/BrandBanner.astro";
import LetsTalkCta from "../../components/LetsTalkCta.astro";
import PageCentered from "../../components/layout/PageCentered.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pages } from "../../data/pages";
import { blogPostPath, blogPostThumbnailPath, formatDate, truncate } from "../../lib/links";
import { getPosts } from "../../lib/posts";

const page = pages.blog;
const posts = await getPosts();
---

<BaseLayout title={page.title} description={page.description} openGraph={page.openGraph}>
  <PageCentered>
    <BrandBanner />
    <div class="bg-white py-8 sm:py-8">
      <div class="mx-auto max-w-[1400px] px-6 lg:px-8">
        <div class="mx-auto max-w-[1400px]">
          <h2 class="text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Blog</h2>
          <p class="mt-2 text-lg/8 text-gray-600">AI, Elixir, MVPs, production mindset and more.</p>
          <div class="mt-16 grid grid-cols-1 gap-x-12 gap-y-16 lg:mt-20 lg:grid-cols-2">
            {
              posts.map((post) => (
                <article id={post.id} class="relative isolate flex flex-col gap-8">
                  <div class="relative aspect-[2/1]">
                    <img
                      src={blogPostThumbnailPath(post)}
                      alt={post.data.title}
                      loading="lazy"
                      class="absolute inset-0 size-full rounded-2xl bg-gray-50 object-cover"
                    />
                    <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-gray-900/10" />
                  </div>
                  <div>
                    <div class="flex items-center gap-x-4 text-xs">
                      <time datetime={formatDate(post.data.date)} class="text-gray-500">
                        {formatDate(post.data.date)}
                      </time>
                    </div>
                    <div class="group relative">
                      <h3 class="mt-3 text-lg/6 font-semibold text-gray-900 group-hover:text-gray-600">
                        <a href={blogPostPath(post)}>
                          <span class="absolute inset-0" />
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="mt-5 text-sm/6 text-gray-600">{truncate(post.data.description, 100)}</p>
                    </div>
                    <div class="flex items-center gap-x-4 text-xs py-4">
                      {post.data.tags.slice(0, 5).map((tag) => (
                        <a
                          href={blogPostPath(post)}
                          class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <LetsTalkCta />
  </PageCentered>
</BaseLayout>
